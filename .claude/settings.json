{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/.credentials.json)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)",
      "Edit(secrets/**)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/.credentials.json)",
      "Edit(.claude/setup-backup/**)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(npm publish *)",
      "Bash(vercel)",
      "Bash(vercel *)",
      "Bash(netlify deploy *)",
      "Bash(gh release *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check_setup.py\" --hook",
            "timeout": 20,
            "statusMessage": "設定ファイルの構造を検査中"
          }
        ]
      }
    ]
  }
}
